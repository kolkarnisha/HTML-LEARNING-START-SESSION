========================================================= */
function renderRoute(){
  if(route.name==='dashboard') return renderDashboard();
  if(route.name==='step') return renderStep(route.stepId);
  if(route.name==='doubts') return renderDoubts();
  if(route.name==='settings') return renderSettings();
  if(route.name==='certificate') return renderCertificate();
  return renderDashboard();
}

/* ---------- DASHBOARD ---------- */
