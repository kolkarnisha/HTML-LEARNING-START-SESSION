function hideSearchOnOutsideClick(e){
  const wrap = document.querySelector('.search-wrap');
  if(wrap && !wrap.contains(e.target)){
    const box = document.getElementById('searchResults');
    if(box) box.style.display='none';
  }
  document.addEventListener('click', hideSearchOnOutsideClick, {once:true});
}

function sidebarItem(s){
  const unlocked = isUnlocked(s.id);
  const done = isCompleted(s.id);
  const current = route.name==='step' && route.stepId===s.id;
  const isNextUp = !done && unlocked && !current && s.id===currentUnlockedStep();
  let cls = 'nav-item';
  if(!unlocked) cls += ' locked';
  if(done) cls += ' done';
  if(current || isNextUp) cls += ' current';
  const numContent = done ? '✓' : String(s.id).padStart(2,'0');
  return `<li class="${cls}" onclick="${unlocked? `navigate('step', ${s.id})` : `lockedClick(${s.id})`}">
    <span class="num">${numContent}</span>
    <span class="label">${escapeHtml(s.title)}</span>
    ${!unlocked ? '<span class="icon-lock">🔒</span>' : ''}
  </li>`;
}
function lockedClick(stepId){
  toast(`🔒 Complete Step ${stepId-1} first to unlock this.`);
}

