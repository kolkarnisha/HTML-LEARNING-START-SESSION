  const v = visuals[stepId];
  if(!v) return '';
  return `<section class="visual-learning" aria-label="Visual explanation for this step">
    <div class="visual-kicker">Visual explanation</div>
    <div class="visual-card">
      <div class="visual-head"><div><h3>${v.title}</h3><p>${v.caption}</p></div><span class="visual-pill">👁 Learn visually</span></div>
      <div class="visual-stage">${v.svg}</div>
      <div class="visual-caption"><strong>What to notice:</strong> Follow the arrows from left to right (or around the loop). Each box represents one responsibility in the real application.</div>
    </div>
  </section>`;
}

function sectionHTML(sec){
  let html = `<div class="card"><h3>${escapeHtml(sec.h)}</h3>`;
  if(sec.body) html += sec.body.map(p=>`<p>${escapeHtml(p)}</p>`).join('');
  if(sec.list) html += `<ul>${sec.list.map(li=>`<li>${escapeHtml(li)}</li>`).join('')}</ul>`;
  if(sec.diagram) html += diagramHTML(sec.diagram);
  if(sec.code) html += codeBlockHTML(sec.code.lang, sec.code.text);
  if(sec.body2) html += sec.body2.map(p=>`<p>${escapeHtml(p)}</p>`).join('');
  if(sec.code2) html += codeBlockHTML(sec.code2.lang, sec.code2.text);
  if(sec.body3) html += sec.body3.map(p=>`<p>${escapeHtml(p)}</p>`).join('');
  if(sec.code3) html += codeBlockHTML(sec.code3.lang, sec.code3.text);
  if(sec.subitems){
    html += sec.subitems.map(si=>`
      <details class="sub-item">
        <summary>${escapeHtml(si.t)}<span class="chev">▶</span></summary>
        <div class="sub-body">
          <p>${escapeHtml(si.body)}</p>
          ${si.code ? codeBlockHTML(si.code.lang, si.code.text) : ''}
        </div>
      </details>
    `).join('');
  }
  html += `</div>`;
  return html;
}

let codeBlockCounter = 0;
function codeBlockHTML(lang, text){
  codeBlockCounter++;
  const id = 'code-'+codeBlockCounter;
  const cls = (lang||'').toLowerCase()==='python' ? 'language-python' :
              (lang||'').toLowerCase()==='javascript' ? 'language-javascript' :
              (lang||'').toLowerCase()==='sql' ? 'language-sql' : 'language-bash';
  return `<div class="code-block">
    <div class="code-head">
      <span class="lang">${escapeHtml(lang||'code')}</span>
      <button class="copy-btn" onclick="copyCode('${id}', this)">Copy</button>
    </div>
    <pre><code id="${id}" class="${cls}">${escapeHtml(text)}</code></pre>
  </div>`;
}
function diagramHTML(text){
  return `<div class="diagram">${escapeHtml(text)}</div>`;
}
function copyCode(id, btn){
  const text = document.getElementById(id).textContent;
  navigator.clipboard.writeText(text).then(()=>{
    const orig = btn.textContent;
    btn.textContent = 'Copied ✓'; btn.classList.add('copied');
    setTimeout(()=>{ btn.textContent = orig; btn.classList.remove('copied'); }, 1600);
  }).catch(()=>toast('Could not copy — select and copy manually'));
}

function quizHTML(step){
  const q = step.quiz;
  return `<div class="quiz-box" id="quiz-${step.id}">
    <div class="q">${escapeHtml(q.q)}</div>
    ${q.options.map((opt,i)=>`<button class="quiz-opt" onclick="answerQuiz(${step.id}, ${i})">${escapeHtml(opt)}</button>`).join('')}
    <div class="quiz-fb" id="quizfb-${step.id}" style="display:none;"></div>
  </div>`;
}

/* ---------- DOUBTS ---------- */
function renderDoubts(){
  return `
    <div class="step-header">
      <div class="crumbs">SUPPORT</div>
      <h1>My Doubts</h1>
      <p style="color:var(--text-dim);font-size:14px;margin-top:6px;">Questions you've flagged while learning. Marked "Open" until you resolve them yourself once you've found the answer.</p>
    </div>
    <button class="btn btn-amber" style="margin-bottom:18px;" onclick="openDoubtModal(null)">❓ Ask a new question</button>
    ${state.doubts.length===0 ? `
      <div class="empty-state"><div class="em">💭</div><h3>No doubts yet</h3><p>Anything you get stuck on while learning will show up here.</p></div>
    ` : state.doubts.map(d=>`
      <div class="doubt-card">
        <div class="dh">
          <div>
            <div class="q">❓ ${escapeHtml(d.text)}</div>
            <div class="meta">Step: ${escapeHtml(d.step)} · ${escapeHtml(d.date)}</div>
          </div>
          <span class="status-pill ${d.status}">${d.status==='open'?'Open':'Resolved'}</span>
        </div>
        <div class="actions">
          ${d.status==='open' ? `<button class="mini-btn" onclick="resolveDoubt(${d.id})">Mark Resolved</button>` : ''}
        </div>
      </div>
    `).join('')}
  `;
}

/* ---------- SETTINGS ---------- */
function renderSettings(){
  return `
    <div class="step-header">
      <div class="crumbs">SETTINGS</div>
      <h1>Progress & Settings</h1>
    </div>
    <div class="card">
      <div class="settings-row">
        <div><div class="st">Overall progress</div><div class="sd">${state.completedSteps.length} / ${roadmap.length} steps completed (${progressPct()}%)</div></div>
        <div class="step-tag">${progressPct()}%</div>
      </div>
      <div class="settings-row">
        <div><div class="st">Doubts recorded</div><div class="sd">${state.doubts.length} total, ${state.doubts.filter(d=>d.status==='open').length} still open</div></div>
        <button class="btn btn-ghost" onclick="navigate('doubts')">View</button>
      </div>
      <div class="settings-row">
        <div><div class="st">Reset my progress</div><div class="sd">Locks all steps again and clears completed steps. Doubts are kept.</div></div>
        <button class="btn btn-danger" onclick="askReset()">Reset Progress</button>
      </div>
    </div>
    <div class="card">
      <h3>How this app remembers your progress</h3>
      <p>Everything — completed steps, your current step, and your doubts — is saved in your browser's <code>localStorage</code>. Nothing is sent to a server, so it stays on this device and this browser only.</p>
    </div>
  `;
}

/* ---------- CERTIFICATE ---------- */
function renderCertificate(){
  const allDone = state.completedSteps.length === roadmap.length;
  if(!allDone){
    const done = state.completedSteps.length;
    return `<div class="empty-state"><div class="em">🎓</div><h3>Certificate locked</h3>
      <p>Complete all ${roadmap.length} steps to unlock your certificate. You're at ${done}/${roadmap.length}.</p>
      <button class="btn btn-teal" style="margin-top:14px;" onclick="navigate('step', ${currentUnlockedStep()})">Continue learning</button>
    </div>`;
  }
  const name = state.learnerName || 'Your Name';
  return `
    <div class="celebrate no-print">
      <div class="emoji">🎉</div>
      <h2>Congratulations!</h2>
      <p>You completed the Python Full-Stack Application Roadmap — ${roadmap.length}/${roadmap.length} steps, 100%.</p>
    </div>
    <div class="cert-wrap" id="certificate">
      <div class="cert-eyebrow">CERTIFICATE OF COMPLETION</div>
      <div class="cert-title">Python Full-Stack Application Roadmap</div>
      <input class="cert-name" id="certNameInput" value="${escapeHtml(name)}" onchange="setLearnerName(this.value)" style="text-align:center;border:none;border-bottom:2px solid var(--line);background:transparent;font-family:var(--font-display);">
      <p class="cert-body">has successfully completed all ${roadmap.length} stages of the roadmap — from Planning &amp; Requirements through Launch &amp; Maintenance — and built a working full-stack application using Python.</p>
      <div class="cert-date">Issued ${new Date().toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'})}</div>
    </div>
    <div class="cta-row no-print" style="margin-top:22px;">
      <button class="btn btn-ghost" onclick="navigate('dashboard')">Review Roadmap</button>
      <button class="btn btn-outline" style="border-color:var(--line);color:var(--ink-2);" onclick="askReset()">Start Again</button>
      <button class="btn btn-amber" onclick="window.print()">⬇ Download / Print Certificate</button>
    </div>
  `;
}
function setLearnerName(val){ state.learnerName = val; saveState(); }

/* =========================================================
   INIT
========================================================= */
hljs.registerAliases(['py'], {languageName:'python'});
route.name = 'dashboard';
render();
</script>
</body>
