  const completed = state.completedSteps.length;
  const remaining = roadmap.length - completed;
  const next = roadmap.find(s=>s.id===currentUnlockedStep());
  const allDone = completed === roadmap.length;

  return `
    <div class="hero">
      <div class="eyebrow">// python full-stack roadmap</div>
      <h1>Build Your First Python Full-Stack Application</h1>
      <p class="lead">Follow the roadmap step by step. Complete each stage, resolve your doubts, and gradually build a production-ready application — from planning to launch.</p>
      <div class="cta-row">
        <button class="btn btn-amber" onclick="navigate('step', ${next.id})">${completed===0?'Start Step 1':'Continue Step '+next.id} →</button>
        ${allDone ? `<button class="btn btn-outline" onclick="navigate('certificate')">🎓 View certificate</button>` : ''}
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat-card"><div class="num">${roadmap.length}</div><div class="lbl">Total steps</div></div>
      <div class="stat-card"><div class="num" style="color:var(--teal)">${completed}</div><div class="lbl">Completed</div></div>
      <div class="stat-card"><div class="num" style="color:var(--amber-dark)">${remaining}</div><div class="lbl">Remaining</div></div>
      <div class="stat-card"><div class="num">${progressPct()}%</div><div class="lbl">Overall progress</div></div>
    </div>

    <div class="section-title"><h2>Your roadmap</h2><span class="step-tag">${completed}/${roadmap.length} done</span></div>
    <div class="roadmap-grid">
      ${roadmap.map(s=>{
        const unlocked = isUnlocked(s.id);
        const done = isCompleted(s.id);
        const cur = !done && unlocked && s.id===currentUnlockedStep();
        let cls='rm-card'; if(!unlocked) cls+=' locked'; if(done) cls+=' done'; if(cur) cls+=' current';
        return `<div class="${cls}" onclick="${unlocked?`navigate('step', ${s.id})`:`lockedClick(${s.id})`}">
          <div class="badge">${done?'✓':(unlocked?s.icon:'🔒')}</div>
          <div>
            <div class="t">Step ${s.id} — ${escapeHtml(s.title)}</div>
            <div class="d">${escapeHtml(s.tagline)}</div>
          </div>
        </div>`;
      }).join('')}
    </div>
  `;
}

/* ---------- STEP PAGE ---------- */
function renderStep(stepId){
  const step = roadmap.find(s=>s.id===stepId);
  if(!step) return renderDashboard();
  if(!isUnlocked(stepId)){
    return `<div class="empty-state"><div class="em">🔒</div><h3>This step is locked</h3>
      <p>Complete Step ${stepId-1} first to unlock "${escapeHtml(step.title)}".</p>
      <button class="btn btn-teal" style="margin-top:14px;" onclick="navigate('step', ${currentUnlockedStep()})">Go to your current step</button>
    </div>`;
  }
  const done = isCompleted(stepId);
  return `
    <div class="step-header">
      <div class="crumbs">STEP ${step.id} OF ${roadmap.length} ${done ? '· ✓ COMPLETED' : ''}</div>
      <h1>${step.icon} ${escapeHtml(step.title)}</h1>
      <div class="why"><strong>Why this matters —</strong> ${escapeHtml(step.why)}</div>
    </div>

    ${learningVisualHTML(step.id)}

    ${step.sections.map(sectionHTML).join('')}

    <div class="card">
      <h3>✅ Before completing Step ${step.id}</h3>
      <ul class="checklist">
        ${step.checklist.map((c,i)=>`<li><input type="checkbox" id="chk-${step.id}-${i}"><label for="chk-${step.id}-${i}">${escapeHtml(c)}</label></li>`).join('')}
      </ul>
    </div>

    <div class="card">
      <h3>🧠 Quick check</h3>
      <div id="quiz-holder-${step.id}">${quizHTML(step)}</div>
    </div>

    <div class="confirm-block">
      <h3>Before moving forward</h3>
      <p>Have you completed this step? This won't unlock Step ${step.id+1 <= roadmap.length ? step.id+1 : ''} until you explicitly confirm.</p>
      <div class="confirm-actions">
        <button class="btn btn-amber" onclick="askCompleteStep(${step.id})">✅ Yes, I completed this step</button>
        <button class="btn btn-outline" onclick="openDoubtModal(${step.id})">❓ I have a doubt</button>
        ${done ? `<button class="btn btn-teal" ${step.id<roadmap.length?`onclick="navigate('step', ${step.id+1})"`:`onclick="navigate('certificate')"`}>${step.id<roadmap.length? 'Go to Step '+(step.id+1)+' →' : 'View certificate 🎓'}</button>` : ''}
      </div>
    </div>
  `;
}


