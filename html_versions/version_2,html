<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Full Stack Trail — Python Roadmap</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/python.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/bash.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/sql.min.js"></script>
<style>
/* =========================================================
   TOKENS
========================================================= */
:root{
  --ink:#0F1E1D;
  --ink-2:#16302D;
  --paper:#EEF3EC;
  --paper-2:#FFFFFF;
  --line:#D8E0D3;
  --amber:#E2A83A;
  --amber-dark:#B9822A;
  --teal:#2F7A6E;
  --teal-light:#DCEFE9;
  --blue:#3B6E8F;
  --red:#C1553D;
  --text:#16302D;
  --text-dim:#5B6E67;
  --text-inv:#EAF1EC;
  --radius-sm:6px;
  --radius:10px;
  --shadow:0 1px 2px rgba(15,30,29,.06), 0 8px 24px -12px rgba(15,30,29,.18);
  --font-display:'Space Grotesk',sans-serif;
  --font-body:'Inter',sans-serif;
  --font-mono:'IBM Plex Mono',monospace;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:var(--font-body);
  background:var(--paper);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  line-height:1.5;
}
h1,h2,h3,h4{font-family:var(--font-display);margin:0;color:var(--ink-2);}
p{margin:0 0 .75em;}
a{color:inherit;}
button{font-family:inherit;cursor:pointer;}
::selection{background:var(--amber);color:var(--ink);}

.step-tag{
  font-family:var(--font-mono);
  font-size:12px;
  letter-spacing:.02em;
  color:var(--teal);
  background:var(--teal-light);
  padding:2px 8px;
  border-radius:20px;
  display:inline-flex;
  align-items:center;
  gap:6px;
}

/* =========================================================
   APP SHELL
========================================================= */
#app{display:flex;min-height:100vh;}

/* ---------- SIDEBAR ---------- */
.sidebar{
  width:290px;
  flex-shrink:0;
  background:var(--ink);
  color:var(--text-inv);
  display:flex;
  flex-direction:column;
  position:sticky;
  top:0;
  height:100vh;
  overflow-y:auto;
  z-index:40;
}
.sidebar-brand{
  padding:22px 20px 14px;
  display:flex;
  align-items:center;
  gap:10px;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.sidebar-brand .mark{
  width:34px;height:34px;border-radius:8px;
  background:linear-gradient(155deg,var(--amber),var(--teal));
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-weight:600;color:var(--ink);font-size:15px;
}
.sidebar-brand .name{font-family:var(--font-display);font-weight:700;font-size:16px;letter-spacing:-.01em;}
.sidebar-brand .sub{font-family:var(--font-mono);font-size:10.5px;color:#8FA79F;margin-top:1px;}

.sidebar-progress{padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.08);}
.sidebar-progress .label{display:flex;justify-content:space-between;font-size:12px;color:#9FB6AE;margin-bottom:8px;}
.sidebar-progress .pct{color:var(--amber);font-family:var(--font-mono);font-weight:600;}
.track{height:6px;border-radius:4px;background:rgba(255,255,255,.1);overflow:hidden;}
.track .fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--amber));transition:width .5s cubic-bezier(.4,0,.2,1);}

.nav-list{list-style:none;margin:0;padding:10px 12px 16px;flex:1;}
.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:10px 12px;border-radius:8px;
  margin-bottom:2px;cursor:pointer;
  border:1px solid transparent;
  transition:background .15s ease;
}
.nav-item:hover{background:rgba(255,255,255,.05);}
.nav-item.locked{cursor:not-allowed;opacity:.42;}
.nav-item.locked:hover{background:transparent;}
.nav-item.current{background:rgba(226,168,58,.12);border-color:rgba(226,168,58,.35);}
.nav-item .num{
  font-family:var(--font-mono);font-size:11px;width:22px;height:22px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
  background:rgba(255,255,255,.08);color:#B9C9C3;
}
.nav-item.done .num{background:var(--teal);color:#fff;}
.nav-item.current .num{background:var(--amber);color:var(--ink);}
.nav-item .label{font-size:13.5px;font-weight:500;color:var(--text-inv);}
.nav-item .icon-lock{margin-left:auto;font-size:12px;opacity:.7;}
.nav-item .icon-check{margin-left:auto;color:var(--teal);font-size:13px;}

.sidebar-footer{padding:12px 12px 18px;border-top:1px solid rgba(255,255,255,.08);}
.sidebar-footer .nav-item{font-size:13px;}

/* ---------- MOBILE SIDEBAR ---------- */
.sidebar-scrim{display:none;}
.mobile-topbar{display:none;}

@media(max-width:900px){
  .sidebar{position:fixed;left:0;top:0;transform:translateX(-100%);transition:transform .25s ease;box-shadow:0 0 40px rgba(0,0,0,.35);}
  .sidebar.open{transform:translateX(0);}
  .sidebar-scrim{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:39;}
  .sidebar-scrim.show{display:block;}
  .mobile-topbar{
    display:flex;align-items:center;gap:12px;justify-content:space-between;
    position:sticky;top:0;z-index:30;background:var(--ink);color:var(--text-inv);
    padding:12px 16px;
  }
  .mobile-topbar .name{font-family:var(--font-display);font-weight:700;font-size:15px;}
  .hamburger{background:none;border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:8px;padding:8px 10px;font-size:16px;line-height:1;}
}

/* ---------- MAIN ---------- */
.main{flex:1;min-width:0;}
.topbar{
  display:flex;align-items:center;gap:16px;
  padding:16px 32px;background:var(--paper-2);border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:20;
}
@media(max-width:900px){.topbar{padding:12px 16px;flex-wrap:wrap;top:52px;}}
.search-wrap{position:relative;flex:1;max-width:420px;}
.search-wrap input{
  width:100%;padding:9px 14px 9px 34px;border-radius:8px;border:1px solid var(--line);
  background:var(--paper);font-size:13.5px;color:var(--text);outline:none;
}
.search-wrap input:focus{border-color:var(--teal);background:#fff;}
.search-wrap .sic{position:absolute;left:11px;top:50%;transform:translateY(-50%);opacity:.5;font-size:14px;}
.search-results{
  position:absolute;top:calc(100% + 6px);left:0;right:0;background:#fff;border:1px solid var(--line);
  border-radius:10px;box-shadow:var(--shadow);max-height:320px;overflow-y:auto;z-index:50;
}
.search-results .sr-item{padding:10px 14px;border-bottom:1px solid var(--line);cursor:pointer;font-size:13px;}
.search-results .sr-item:last-child{border:none;}
.search-results .sr-item:hover{background:var(--paper);}
.search-results .sr-item .sr-title{font-weight:600;color:var(--ink-2);}
.search-results .sr-item .sr-meta{color:var(--text-dim);font-size:11.5px;margin-top:2px;}
.search-results .sr-empty{padding:16px;color:var(--text-dim);font-size:13px;text-align:center;}

.topbar-actions{display:flex;gap:8px;margin-left:auto;}
.tb-btn{
  border:1px solid var(--line);background:#fff;border-radius:8px;padding:8px 13px;font-size:13px;font-weight:500;
  color:var(--ink-2);display:flex;align-items:center;gap:6px;
}
.tb-btn:hover{border-color:var(--teal);}
.tb-btn.primary{background:var(--ink);color:#fff;border-color:var(--ink);}

.content{padding:32px;max-width:920px;margin:0 auto;}
@media(max-width:900px){.content{padding:20px 16px;}}

/* =========================================================
   DASHBOARD
========================================================= */
.hero{
  background:linear-gradient(155deg,var(--ink) 0%,var(--ink-2) 60%, #1d3d38 100%);
  color:var(--text-inv);border-radius:16px;padding:38px 34px;position:relative;overflow:hidden;margin-bottom:22px;
}
.hero::after{
  content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;
  background:radial-gradient(circle,rgba(226,168,58,.25),transparent 70%);
}
.hero .eyebrow{font-family:var(--font-mono);font-size:12px;color:var(--amber);margin-bottom:10px;}
.hero h1{font-size:30px;line-height:1.15;max-width:640px;letter-spacing:-.02em;color:#fff;}
.hero p.lead{color:#B9C9C3;max-width:560px;margin-top:12px;font-size:15px;}
.hero .cta-row{display:flex;gap:12px;margin-top:22px;flex-wrap:wrap;}
.btn{
  border:none;border-radius:9px;padding:11px 20px;font-size:14px;font-weight:600;
  display:inline-flex;align-items:center;gap:8px;transition:transform .12s ease;
}
.btn:active{transform:scale(.97);}
.btn-amber{background:var(--amber);color:var(--ink);}
.btn-amber:hover{background:#eeb84e;}
.btn-outline{background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff;}
.btn-outline:hover{background:rgba(255,255,255,.08);}
.btn-teal{background:var(--teal);color:#fff;}
.btn-teal:hover{background:#256459;}
.btn-ghost{background:transparent;color:var(--ink-2);border:1px solid var(--line);}
.btn-ghost:hover{border-color:var(--teal);}
.btn-danger{background:var(--red);color:#fff;}
.btn:disabled{opacity:.5;cursor:not-allowed;}

.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:26px;}
@media(max-width:760px){.stat-grid{grid-template-columns:repeat(2,1fr);}}
.stat-card{background:var(--paper-2);border:1px solid var(--line);border-radius:12px;padding:18px;}
.stat-card .num{font-family:var(--font-display);font-size:26px;font-weight:700;color:var(--ink-2);}
.stat-card .lbl{font-size:12px;color:var(--text-dim);margin-top:2px;}

.section-title{display:flex;align-items:center;justify-content:space-between;margin:30px 0 14px;}
.section-title h2{font-size:19px;}

.roadmap-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:760px){.roadmap-grid{grid-template-columns:1fr;}}
.rm-card{
  background:var(--paper-2);border:1px solid var(--line);border-radius:12px;padding:16px 16px 16px 14px;
  display:flex;gap:12px;align-items:flex-start;cursor:pointer;transition:border-color .15s ease, box-shadow .15s ease;
}
.rm-card:hover{border-color:var(--teal);box-shadow:var(--shadow);}
.rm-card.locked{cursor:not-allowed;opacity:.55;}
.rm-card.locked:hover{border-color:var(--line);box-shadow:none;}
.rm-card .badge{
  width:32px;height:32px;border-radius:9px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-size:13px;font-weight:600;background:var(--paper);color:var(--text-dim);
}
.rm-card.done .badge{background:var(--teal);color:#fff;}
.rm-card.current .badge{background:var(--amber);color:var(--ink);}
.rm-card .t{font-weight:600;font-size:14px;color:var(--ink-2);}
.rm-card .d{font-size:12.5px;color:var(--text-dim);margin-top:2px;}

/* =========================================================
   STEP PAGE
========================================================= */
.step-header{margin-bottom:22px;}
.step-header .crumbs{font-family:var(--font-mono);font-size:12px;color:var(--text-dim);margin-bottom:10px;}
.step-header h1{font-size:27px;letter-spacing:-.01em;}
.step-header .why{
  margin-top:12px;background:var(--teal-light);border-left:3px solid var(--teal);border-radius:0 8px 8px 0;
  padding:12px 16px;font-size:13.5px;color:#1E4941;
}

.card{background:var(--paper-2);border:1px solid var(--line);border-radius:12px;padding:20px 22px;margin-bottom:16px;}
.card h3{font-size:16px;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.card ul{margin:0;padding-left:20px;}
.card li{margin-bottom:6px;font-size:14px;}
.card p{font-size:14px;color:var(--text);}

.sub-item{border:1px solid var(--line);border-radius:10px;margin-bottom:10px;overflow:hidden;}
.sub-item summary{
  list-style:none;cursor:pointer;padding:13px 16px;font-weight:600;font-size:14px;color:var(--ink-2);
  display:flex;justify-content:space-between;align-items:center;background:#FAFBF8;
}
.sub-item summary::-webkit-details-marker{display:none;}
.sub-item summary .chev{transition:transform .2s ease;font-size:12px;color:var(--text-dim);}
.sub-item[open] summary .chev{transform:rotate(90deg);}
.sub-item .sub-body{padding:4px 16px 16px;font-size:13.5px;}
.sub-item .sub-body ul{padding-left:18px;}
.sub-item .sub-body li{margin-bottom:5px;}

.code-block{border-radius:10px;overflow:hidden;margin:10px 0 16px;border:1px solid #1c1c1c;}
.code-head{
  background:#1c1f1e;color:#c9d1cd;font-family:var(--font-mono);font-size:11.5px;
  padding:8px 12px;display:flex;justify-content:space-between;align-items:center;
}
.code-head .lang{letter-spacing:.03em;text-transform:uppercase;color:#8FA79F;}
.copy-btn{background:rgba(255,255,255,.08);border:none;color:#dfe7e3;padding:4px 9px;border-radius:5px;font-size:11px;font-family:var(--font-body);}
.copy-btn:hover{background:rgba(255,255,255,.16);}
.copy-btn.copied{background:var(--teal);color:#fff;}
pre{margin:0;padding:14px;overflow-x:auto;font-size:12.8px;}
pre code{font-family:var(--font-mono)!important;}

.diagram{
  background:#0F1E1D;color:#B9C9C3;border-radius:10px;padding:16px;font-family:var(--font-mono);
  font-size:12.5px;white-space:pre;overflow-x:auto;line-height:1.5;margin:10px 0 16px;
}

.checklist{list-style:none;margin:0;padding:0;}
.checklist li{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px dashed var(--line);font-size:14px;}
.checklist li:last-child{border:none;}
.checklist input{margin-top:3px;width:16px;height:16px;accent-color:var(--teal);flex-shrink:0;}

.quiz-box{background:#FAFBF8;border:1px dashed var(--line);border-radius:10px;padding:16px;}
.quiz-box .q{font-weight:600;font-size:14px;margin-bottom:10px;}
.quiz-opt{
  display:block;width:100%;text-align:left;background:#fff;border:1px solid var(--line);border-radius:8px;
  padding:10px 12px;margin-bottom:8px;font-size:13.5px;color:var(--text);
}
.quiz-opt:hover{border-color:var(--teal);}
.quiz-opt.correct{border-color:var(--teal);background:var(--teal-light);}
.quiz-opt.wrong{border-color:var(--red);background:#FBEAE6;}
.quiz-fb{font-size:13px;margin-top:8px;padding:10px 12px;border-radius:8px;}
.quiz-fb.ok{background:var(--teal-light);color:#1E4941;}
.quiz-fb.no{background:#FBEAE6;color:#7A3323;}

.confirm-block{
  margin-top:26px;background:var(--ink);color:var(--text-inv);border-radius:14px;padding:24px 26px;
}
.confirm-block h3{color:#fff;font-size:17px;margin-bottom:4px;}
.confirm-block p{color:#9FB6AE;font-size:13.5px;margin-bottom:16px;}
.confirm-actions{display:flex;gap:12px;flex-wrap:wrap;}

/* =========================================================
   MODALS / TOASTS
========================================================= */
.overlay{position:fixed;inset:0;background:rgba(15,30,29,.55);display:none;align-items:center;justify-content:center;z-index:100;padding:20px;}
.overlay.show{display:flex;}
.modal{background:#fff;border-radius:14px;max-width:440px;width:100%;padding:26px;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.modal h3{font-size:18px;margin-bottom:8px;}
.modal p{font-size:14px;color:var(--text-dim);}
.modal .modal-actions{display:flex;gap:10px;margin-top:20px;justify-content:flex-end;}
.modal.wide{max-width:520px;}
.modal textarea, .modal select, .modal input[type=text]{
  width:100%;border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13.5px;font-family:inherit;
  margin-top:6px;resize:vertical;
}
.modal label{font-size:12.5px;font-weight:600;color:var(--ink-2);display:block;margin-top:14px;}
.modal .success-icon{width:52px;height:52px;border-radius:50%;background:var(--teal-light);color:var(--teal);
  display:flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:14px;}

.toast-stack{position:fixed;bottom:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:10px;}
@media(max-width:900px){.toast-stack{left:16px;right:16px;bottom:16px;}}
.toast{
  background:var(--ink);color:#fff;padding:13px 16px;border-radius:10px;font-size:13.5px;box-shadow:var(--shadow);
  display:flex;align-items:center;gap:10px;min-width:240px;animation:toastin .25s ease;
}
@keyframes toastin{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

/* =========================================================
   DOUBTS / SETTINGS
========================================================= */
.doubt-card{background:var(--paper-2);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:12px;}
.doubt-card .dh{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
.doubt-card .q{font-weight:600;font-size:14px;color:var(--ink-2);}
.doubt-card .meta{font-size:11.5px;color:var(--text-dim);margin-top:4px;font-family:var(--font-mono);}
.status-pill{font-size:11px;padding:3px 9px;border-radius:20px;font-weight:600;white-space:nowrap;}
.status-pill.open{background:#FDF1DD;color:var(--amber-dark);}
.status-pill.resolved{background:var(--teal-light);color:var(--teal);}
.doubt-card .actions{margin-top:10px;display:flex;gap:8px;}
.mini-btn{font-size:12px;padding:6px 11px;border-radius:6px;border:1px solid var(--line);background:#fff;}
.mini-btn:hover{border-color:var(--teal);}
.empty-state{text-align:center;padding:50px 20px;color:var(--text-dim);}
.empty-state .em{font-size:34px;margin-bottom:10px;}

.settings-row{display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px solid var(--line);}
.settings-row:last-child{border:none;}
.settings-row .st{font-weight:600;font-size:14px;color:var(--ink-2);}
.settings-row .sd{font-size:12.5px;color:var(--text-dim);margin-top:2px;}

/* =========================================================
   CERTIFICATE
========================================================= */
.cert-wrap{background:var(--paper-2);border:1px solid var(--line);border-radius:16px;padding:50px;text-align:center;position:relative;}
.cert-wrap::before{content:"";position:absolute;inset:14px;border:1.5px solid var(--amber);border-radius:10px;pointer-events:none;}
.cert-eyebrow{font-family:var(--font-mono);font-size:12px;color:var(--teal);letter-spacing:.04em;}
.cert-title{font-size:26px;margin:14px 0 4px;}
.cert-name{font-family:var(--font-display);font-size:32px;color:var(--amber-dark);margin:18px 0;border-bottom:2px solid var(--line);display:inline-block;padding-bottom:10px;min-width:280px;}
.cert-body{color:var(--text-dim);font-size:14px;max-width:460px;margin:0 auto;}
.cert-date{font-family:var(--font-mono);font-size:12px;color:var(--text-dim);margin-top:20px;}
@media print{
  .sidebar,.topbar,.mobile-topbar,.no-print{display:none!important;}
  .content{max-width:100%;padding:0;}
}

.fade-in{animation:fadein .3s ease;}
@keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

/* completion celebration */
.celebrate{text-align:center;padding:40px 20px;}
.celebrate .emoji{font-size:52px;}
.celebrate h2{font-size:24px;margin:14px 0 6px;}
.celebrate p{color:var(--text-dim);font-size:14px;}
/* =========================================================
   EDUCATIONAL VISUALS — embedded, offline-friendly SVGs
========================================================= */
.visual-learning{margin:20px 0 26px;}
.visual-learning .visual-kicker{font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:var(--teal);margin-bottom:8px;}
.visual-card{background:linear-gradient(180deg,#ffffff 0%,#f8fbfa 100%);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 12px 32px rgba(20,46,42,.08);}
.visual-card .visual-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;padding:18px 20px 10px;}
.visual-card .visual-head h3{margin:0;font-size:18px;}
.visual-card .visual-head p{margin:5px 0 0;color:var(--ink-3);font-size:13px;line-height:1.55;}
.visual-stage{padding:8px 18px 18px;}
.visual-stage svg{display:block;width:100%;height:auto;max-height:430px;}
.visual-caption{padding:0 20px 18px;color:var(--ink-3);font-size:13px;line-height:1.55;}
