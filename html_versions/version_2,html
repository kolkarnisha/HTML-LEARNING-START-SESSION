/* =========================================================
   STATE MANAGEMENT
========================================================= */
const STORAGE_KEY = 'pyRoadmapState_v1';

function defaultState(){
  return { completedSteps:[], currentStep:1, doubts:[], quizDone:{}, learnerName:'' };
}

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return defaultState();
    const parsed = JSON.parse(raw);
    return Object.assign(defaultState(), parsed);
  }catch(e){
    console.error('State load failed, resetting', e);
    return defaultState();
  }
}

function saveState(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch(e){ console.error('State save failed', e); toast('⚠️ Could not save progress locally'); }
}

let state = loadState();
let route = { name:'dashboard', stepId:null };
let pendingCompleteStep = null;
let doubtContextStep = null;
let pendingDoubtStepAfter = null;

function isUnlocked(stepId){ return stepId === 1 || state.completedSteps.includes(stepId-1); }
function isCompleted(stepId){ return state.completedSteps.includes(stepId); }
function progressPct(){ return Math.round((state.completedSteps.length / roadmap.length) * 100); }
function currentUnlockedStep(){
  for(const s of roadmap){ if(!isCompleted(s.id)) return s.id; }
  return roadmap.length;
}

/* =========================================================
   ROUTER
========================================================= */
function navigate(name, stepId){
  route = { name, stepId: stepId || null };
  closeSidebarMobile();
  window.scrollTo(0,0);
  render();
}

/* =========================================================
   TOASTS
========================================================= */
function toast(msg, ms=3200){
  const stack = document.getElementById('toastStack');
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<span>${msg}</span>`;
  stack.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transition='opacity .25s'; setTimeout(()=>el.remove(),250); }, ms);
}

/* =========================================================
   MODALS
========================================================= */
function openModal(id){ document.getElementById(id).classList.add('show'); }
function closeModal(id){ document.getElementById(id).classList.remove('show'); }

function askCompleteStep(stepId){
  pendingCompleteStep = stepId;
  openModal('confirmModal');
}

function confirmCompleteStep(){
  closeModal('confirmModal');
  const stepId = pendingCompleteStep;
  if(stepId == null) return;
  if(!state.completedSteps.includes(stepId)){
    state.completedSteps.push(stepId);
    state.currentStep = Math.min(stepId+1, roadmap.length);
    saveState();
  }
  const isLast = stepId === roadmap.length;
  const nextStep = roadmap.find(s=>s.id===stepId+1);
  document.getElementById('successTitle').textContent = isLast ? '🎉 Roadmap complete!' : `🎉 Step ${stepId} completed!`;
  document.getElementById('successBody').textContent = isLast
    ? `You've finished all ${roadmap.length} steps. Your certificate is ready.`
    : `Step ${stepId+1} — ${nextStep.title} is now unlocked.`;
  const btn = document.getElementById('successContinueBtn');
  btn.textContent = isLast ? 'View certificate →' : `Continue to Step ${stepId+1} →`;
  btn.onclick = ()=>{
    closeModal('successModal');
    if(isLast) navigate('certificate'); else navigate('step', stepId+1);
  };
  openModal('successModal');
}

function openDoubtModal(stepId){
  doubtContextStep = stepId;
  const sel = document.getElementById('doubtTopic');
  sel.innerHTML = '<option value="">General / not sure</option>' +
    roadmap.map(s=>`<option value="${s.title}">${s.title}</option>`).join('');
  if(stepId){ const s = roadmap.find(r=>r.id===stepId); if(s) sel.value = s.title; }
  document.getElementById('doubtText').value='';
  openModal('doubtModal');
}

function submitDoubt(){
  const text = document.getElementById('doubtText').value.trim();
  if(!text){ toast('Please write your question first'); return; }
  const topic = document.getElementById('doubtTopic').value;
  const stepObj = doubtContextStep ? roadmap.find(s=>s.id===doubtContextStep) : null;
  state.doubts.unshift({
    id: Date.now(),
    text, topic: topic || (stepObj ? stepObj.title : 'General'),
    step: stepObj ? stepObj.title : (topic || 'General'),
    status:'open',
    date: new Date().toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'})
  });
  saveState();
  closeModal('doubtModal');
  pendingDoubtStepAfter = doubtContextStep;
  openModal('doubtSuccessModal');
}

document.getElementById('reviewStepBtn').onclick = ()=>{
  closeModal('doubtSuccessModal');
  if(pendingDoubtStepAfter) navigate('step', pendingDoubtStepAfter); else render();
};
document.getElementById('continueLearningBtn').onclick = ()=>{
  closeModal('doubtSuccessModal');
  render();
};

function resolveDoubt(id){
  const d = state.doubts.find(x=>x.id===id);
  if(d){ d.status = 'resolved'; saveState(); render(); toast('Doubt marked as resolved'); }
}

function askReset(){ openModal('resetModal'); }
function doResetProgress(){
  const doubts = state.doubts;
  state = defaultState();
  state.doubts = doubts;
  saveState();
  closeModal('resetModal');
  toast('Progress reset — Step 1 is unlocked, the rest are locked');
  navigate('dashboard');
}

/* =========================================================
   QUIZ HANDLING
========================================================= */
function answerQuiz(stepId, chosenIdx){
  const step = roadmap.find(s=>s.id===stepId);
  const opts = document.querySelectorAll(`#quiz-${stepId} .quiz-opt`);
  opts.forEach((el,i)=>{
    el.disabled = true;
    if(i===step.quiz.correct) el.classList.add('correct');
    else if(i===chosenIdx) el.classList.add('wrong');
  });
  const fb = document.getElementById(`quizfb-${stepId}`);
  const correct = chosenIdx === step.quiz.correct;
  fb.style.display='block';
  fb.className = 'quiz-fb ' + (correct ? 'ok':'no');
  fb.innerHTML = (correct ? '✅ Correct. ' : '❌ Not quite. ') + step.quiz.explain +
    (correct ? '' : '<div style="margin-top:8px;"><button class="mini-btn" onclick="retryQuiz('+stepId+')">Try again</button></div>');
  if(correct){ state.quizDone[stepId]=true; saveState(); }
}
function retryQuiz(stepId){
  renderStepQuizArea(stepId);
}
function renderStepQuizArea(stepId){
  const holder = document.getElementById(`quiz-holder-${stepId}`);
  if(holder) holder.innerHTML = quizHTML(roadmap.find(s=>s.id===stepId));
}

/* =========================================================
   SEARCH
========================================================= */
function buildSearchIndex(){
  const idx = [];
  roadmap.forEach(step=>{
    step.sections.forEach(sec=>{
      idx.push({ stepId: step.id, stepTitle: step.title, heading: sec.h || step.title, snippet:(sec.body||[]).join(' ').slice(0,90) });
      (sec.subitems||[]).forEach(si=>{
        idx.push({ stepId: step.id, stepTitle: step.title, heading: si.t, snippet:(si.body||'').slice(0,90) });
      });
    });
  });
  return idx;
}
const searchIndex = buildSearchIndex();

function handleSearchInput(val){
  const box = document.getElementById('searchResults');
  if(!val.trim()){ box.style.display='none'; box.innerHTML=''; return; }
  const q = val.toLowerCase();
  const matches = searchIndex.filter(item =>
    item.heading.toLowerCase().includes(q) || item.stepTitle.toLowerCase().includes(q) || item.snippet.toLowerCase().includes(q)
  ).slice(0,8);
  if(matches.length===0){
    box.innerHTML = `<div class="sr-empty">No matches for "${escapeHtml(val)}"</div>`;
  } else {
    box.innerHTML = matches.map(m=>{
      const locked = !isUnlocked(m.stepId);
      if(locked){
        return `<div class="sr-item" style="opacity:.65;cursor:default;">
          <div class="sr-title">🔒 ${escapeHtml(m.heading)}</div>
          <div class="sr-meta">This topic is available after completing Step ${m.stepId-1}.</div>
        </div>`;
      }
      return `<div class="sr-item" onclick="goFromSearch(${m.stepId})">
        <div class="sr-title">${escapeHtml(m.heading)}</div>
        <div class="sr-meta">Step ${m.stepId} · ${escapeHtml(m.stepTitle)}</div>
      </div>`;
    }).join('');
  }
  box.style.display='block';
}
function goFromSearch(stepId){
  document.getElementById('searchResults').style.display='none';
  document.getElementById('searchInput').value='';
  navigate('step', stepId);
}
function escapeHtml(str){
  return str.replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

