<div id="app"></div>
<div class="toast-stack" id="toastStack"></div>

<!-- ===================== MODALS ===================== -->
<div class="overlay" id="confirmModal">
  <div class="modal">
    <h3>Confirm completion</h3>
    <p>Are you sure you understand and completed this step? The next step will unlock immediately.</p>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('confirmModal')">Go Back</button>
      <button class="btn btn-teal" onclick="confirmCompleteStep()">Yes, Mark as Completed</button>
    </div>
  </div>
</div>

<div class="overlay" id="successModal">
  <div class="modal">
    <div class="success-icon">🎉</div>
    <h3 id="successTitle">Step completed!</h3>
    <p id="successBody">Nice work — the next step is now unlocked.</p>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('successModal')">Stay here</button>
      <button class="btn btn-teal" id="successContinueBtn">Continue →</button>
    </div>
  </div>
</div>

<div class="overlay" id="doubtModal">
  <div class="modal wide">
    <h3>What are you stuck on?</h3>
    <p>Write your question below. This is saved to "My Doubts" so you can track and revisit it — there's no live tutor answering yet.</p>
    <label for="doubtTopic">Topic (optional)</label>
    <select id="doubtTopic"></select>
    <label for="doubtText">Your question</label>
    <textarea id="doubtText" rows="4" placeholder="e.g. I don't understand the difference between Django and FastAPI."></textarea>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('doubtModal')">Cancel</button>
      <button class="btn btn-amber" onclick="submitDoubt()">Submit doubt</button>
    </div>
  </div>
</div>

<div class="overlay" id="doubtSuccessModal">
  <div class="modal">
    <div class="success-icon" style="background:#FDF1DD;color:var(--amber-dark);">❓</div>
    <h3>Your doubt has been recorded</h3>
    <p>You can find it any time under "My Doubts" in the sidebar.</p>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="reviewStepBtn">Review Step Again</button>
      <button class="btn btn-teal" id="continueLearningBtn">Continue Learning</button>
    </div>
  </div>
</div>

<div class="overlay" id="resetModal">
  <div class="modal">
    <h3>Reset your progress?</h3>
    <p>This will lock all steps again, clear completed steps, and reset your progress to 0%. Your doubts will be kept.</p>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('resetModal')">Cancel</button>
      <button class="btn btn-danger" onclick="doResetProgress()">Reset Progress</button>
    </div>
  </div>
</div>

